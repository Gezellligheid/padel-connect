# ── Padel Connect ────────────────────────────────────────────────────────────
# Leave everything empty to run in DEMO MODE (all data on-device, no backend).
# Fill these in to run on Firebase.

# Client SDK config (Firebase console → Project settings → Your apps → Web app)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Server credentials (Firebase console → Project settings → Service accounts →
# Generate new private key). Paste the JSON on one line, or base64-encode it.
NUXT_FIREBASE_SERVICE_ACCOUNT=

# Pincode for the management dashboard (/manage)
NUXT_ADMIN_PIN=2468

# Random string used to sign management sessions
NUXT_SESSION_SECRET=change-me-to-something-random

# Pincode used by the management dashboard while in demo mode
NUXT_PUBLIC_DEMO_ADMIN_PIN=2468
